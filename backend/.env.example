# PostgreSQL connection string
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/inventory

# Long random string used to sign login tokens (change this!)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=4000
# Frontend origin allowed by CORS (comma-separated). On Render, use your Vercel URL.
# *.vercel.app is also allowed. Use * only if you must.
CORS_ORIGIN=http://localhost:5173
# Where uploaded documents and logos are stored
UPLOAD_DIR=uploads

# Public address of the app (used in emails, portal links and payment webhooks)
APP_URL=http://localhost:5173
# Optional: separate key for encrypting stored passwords/API keys (defaults to JWT_SECRET).
# Never change it after saving email or integration settings, or they must be re-entered.
APP_SECRET=

# Public org signup: open | invite_only | closed (default invite_only — platform creates clients)
SIGNUP_MODE=invite_only
# Trial length in days for open self-serve signups
TRIAL_DAYS=14

# First Super Admin (created on startup if no platform admin with this email exists)
PLATFORM_ADMIN_EMAIL=admin@rokesh.com
PLATFORM_ADMIN_PASSWORD=change-me-platform-password
PLATFORM_ADMIN_NAME=Platform Admin
